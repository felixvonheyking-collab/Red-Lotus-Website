<style>
  :root{
    --bg:#1c1a17;
    --bg-2:#232019;
    --red:#c8382b;
    --red-bright:#e0473a;
    --gold:#d3b78c;
    --gold-soft:#bfa274;
    --cream:#f5f0e6;
    --cream-dim:#cdc6b8;
    --line:rgba(211,183,140,0.22);
    --serif:'Cormorant Garamond', Georgia, serif;
    --sans:'Bricolage Grotesque', sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg);
    color:var(--cream);
    font-family:var(--sans);
    font-weight:400;
    line-height:1.6;
    overflow-x:hidden;
  }
  img{max-width:100%;display:block;}
  a{color:inherit;text-decoration:none;}
  a:focus-visible,button:focus-visible,summary:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--gold);outline-offset:3px;border-radius:2px;}
  .eyebrow{
    font-family:var(--sans);
    font-size:0.72rem;
    letter-spacing:0.32em;
    text-transform:uppercase;
    color:var(--gold);
    font-weight:600;
  }
  h1,h2,h3{font-family:var(--serif);font-weight:500;color:var(--cream);}
  .wrap{max-width:1180px;margin:0 auto;padding:0 32px;}
  .wrap-wide{max-width:1440px;}
  .btn{
    display:inline-flex;align-items:center;gap:10px;
    padding:16px 30px;
    font-family:var(--sans);font-size:0.78rem;letter-spacing:0.14em;text-transform:uppercase;font-weight:600;
    border-radius:2px;
    transition:all .25s ease;
    border:1px solid transparent;
    white-space:nowrap;
    cursor:pointer;
  }
  .btn-primary{background:var(--red);color:var(--cream);}
  .btn-primary:hover{background:var(--red-bright);transform:translateY(-1px);}
  .btn-outline{border-color:var(--gold-soft);color:var(--cream);}
  .btn-outline:hover{border-color:var(--gold);background:rgba(211,183,140,0.08);}

  /* Header */
  header{
    position:fixed;top:0;left:0;right:0;z-index:100;
    background:linear-gradient(to bottom, rgba(23,20,17,0.92), rgba(23,20,17,0));
    padding:22px 0;
  }
  header .wrap{display:flex;align-items:center;justify-content:space-between;gap:24px;}
  .logo img{height:58px;width:auto;filter:drop-shadow(0 2px 10px rgba(0,0,0,0.5));}
  .nav-toggle{display:none;background:none;border:1px solid var(--line);width:44px;height:44px;border-radius:50%;color:var(--cream);font-size:1.1rem;align-items:center;justify-content:center;}
  nav{display:flex;align-items:center;gap:34px;}
  nav a{font-size:0.72rem;letter-spacing:0.14em;text-transform:uppercase;font-weight:600;color:var(--cream-dim);position:relative;padding:6px 0;}
  nav a:hover, nav a.active{color:var(--gold);}
  .nav-dropdown{position:relative;}
  .nav-dropdown:hover .dropdown-menu,.nav-dropdown:focus-within .dropdown-menu{opacity:1;visibility:visible;transform:translateY(0);}
  .dropdown-menu{
    position:absolute;top:100%;left:50%;transform:translate(-50%,6px);
    background:var(--bg-2);border:1px solid var(--line);
    min-width:230px;padding:10px 0;margin-top:8px;
    opacity:0;visibility:hidden;transition:all .2s ease;
  }
  .dropdown-menu a{display:block;padding:12px 22px;font-size:0.7rem;letter-spacing:0.08em;color:var(--cream-dim);}
  .dropdown-menu a:hover{color:var(--gold);background:rgba(211,183,140,0.06);}
  .header-icons{display:flex;gap:16px;align-items:center;}
  .header-icons a{width:34px;height:34px;border:1px solid var(--line);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:0.9rem;}
  .header-icons a:hover{border-color:var(--gold);}

  /* Page hero */
  .page-hero{
    position:relative;min-height:64vh;display:flex;align-items:flex-end;
    background:
      linear-gradient(180deg, rgba(20,17,14,0.5) 0%, rgba(20,17,14,0.78) 60%, rgba(20,17,14,0.98) 100%),
      url('img/foodtruck-abend-buffet.jpg') center 55%/cover no-repeat;
    padding-bottom:64px;
  }
  .page-hero-content{max-width:700px;padding-top:140px;}
  .breadcrumb{font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--cream-dim);margin-bottom:20px;display:block;}
  .breadcrumb a{color:var(--gold);}
  .page-hero h1{font-size:clamp(2.2rem,4.6vw,3.6rem);line-height:1.1;margin-bottom:20px;}
  .page-hero p.lead{font-size:1.05rem;color:var(--cream-dim);max-width:520px;margin-bottom:30px;}
  .hero-ctas{display:flex;flex-wrap:wrap;gap:16px;}

  /* Section generic */
  section{padding:120px 0;}
  .section-head{max-width:640px;margin:0 auto 60px;text-align:center;}
  .section-head .eyebrow{display:block;margin-bottom:16px;}
  .section-head h2{font-size:clamp(2rem,3.6vw,2.6rem);}
  .section-head p{color:var(--cream-dim);margin-top:18px;font-size:1rem;}

  /* Market days */
  .markets{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);}
  .market-card{background:var(--bg-2);padding:44px 36px;text-align:center;}
  .market-card .day{font-family:var(--serif);font-size:1.6rem;color:var(--red);margin-bottom:10px;}
  .market-card h3{font-size:1.1rem;margin-bottom:10px;}
  .market-card p{color:var(--cream-dim);font-size:0.88rem;}

  /* Two-col image + text */
  #live-cooking{padding:0;}
  .split{display:grid;grid-template-columns:0.9fr 1.3fr;min-height:520px;}
  .split-img{position:relative;overflow:hidden;}
  .split-img img{width:100%;height:100%;object-fit:cover;display:block;}
  .split-text{background:var(--bg-2);display:flex;align-items:center;padding:64px 60px;}
  /* Live-Cooking-Variante: schmaleres, kürzeres Bild statt komplett bildschirmfüllendem Portrait-Crop */
  #live-cooking .split{grid-template-columns:0.68fr 1.32fr;min-height:0;}
  #live-cooking .split-img{align-self:center;max-height:440px;}
  .split-text .eyebrow{display:block;margin-bottom:16px;}
  .split-text h2{font-size:clamp(1.7rem,2.6vw,2.3rem);margin-bottom:18px;}
  .split-text p{color:var(--cream-dim);margin-bottom:12px;}

  /* Two trucks */
  .trucks-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line);}
  .truck-card{background:var(--bg-2);}
  .truck-card img{width:100%;height:280px;object-fit:cover;display:block;}
  .truck-card-body{padding:32px 34px;}
  .truck-card .eyebrow{display:block;margin-bottom:12px;}
  .truck-card h3{font-size:1.25rem;margin-bottom:10px;}
  .truck-card p{color:var(--cream-dim);font-size:0.9rem;}

  /* Food impressions gallery */
  .impressions{background:var(--bg-2);}
  .impressions-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
  .impressions-grid a{position:relative;overflow:hidden;display:block;height:320px;}
  .impressions-grid img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease;}
  .impressions-grid a:hover img{transform:scale(1.06);}
  .impressions-grid a::after{content:'';position:absolute;inset:0;box-shadow:inset 0 0 0 1px var(--line);}

  /* FAQ accordion */
  .faq{max-width:760px;margin:0 auto;}
  .faq-item{border-bottom:1px solid var(--line);}
  .faq-item summary{
    padding:22px 0;font-family:var(--serif);font-size:1.15rem;font-weight:500;color:var(--cream);
    cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:20px;
    list-style:none;
  }
  .faq-item summary::-webkit-details-marker{display:none;}
  .faq-item summary::after{content:'+';font-family:var(--sans);font-size:1.3rem;color:var(--gold);flex-shrink:0;transition:transform .2s ease;}
  .faq-item[open] summary::after{transform:rotate(45deg);}
  .faq-item p{color:var(--cream-dim);padding-bottom:22px;font-size:0.92rem;max-width:640px;}

  /* CTA band */
  .cta-band{background:var(--bg-2);text-align:center;}
  .cta-band h2{font-size:clamp(1.8rem,3vw,2.4rem);margin-bottom:20px;}
  .cta-band p{color:var(--cream-dim);margin-bottom:32px;max-width:520px;margin-left:auto;margin-right:auto;}
  .cta-ctas{display:flex;justify-content:center;flex-wrap:wrap;gap:16px;}

  /* Footer */
  footer{background:var(--bg-2);border-top:1px solid var(--line);padding:80px 0 40px;}
  .footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:50px;margin-bottom:60px;}
  .footer-logo img{height:70px;margin-bottom:20px;}
  .footer-grid p{color:var(--cream-dim);font-size:0.88rem;max-width:280px;}
  .footer-col h3{font-size:0.7rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--gold);margin-bottom:20px;}
  .footer-col a{display:block;font-size:0.85rem;color:var(--cream-dim);margin-bottom:12px;}
  .footer-col a:hover{color:var(--gold);}
  .footer-social{display:flex;gap:14px;margin-top:20px;}
  .footer-social a{width:38px;height:38px;border:1px solid var(--line);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--gold);}
  .footer-insta-teaser{font-size:0.8rem;color:var(--cream-dim);margin-top:16px;}
  .footer-insta-teaser a{color:var(--gold);border-bottom:1px solid var(--line);}
  .footer-bottom{border-top:1px solid var(--line);padding-top:28px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px;font-size:0.75rem;color:var(--cream-dim);}
  .footer-bottom a{margin-left:18px;}

  .mobile-nav{display:none;}
  @media(max-width:960px){
    nav{display:none;}
    .nav-toggle{display:flex;width:38px;height:38px;font-size:0.95rem;}
    header{background-color:#1c1a17;background-image:none;padding:14px 0;}
    .logo img{height:32px;}
    .header-icons{gap:10px;}
    .header-icons a{width:30px;height:30px;font-size:0.8rem;}
    .mobile-nav{
      display:block;
      position:absolute;top:100%;left:0;right:0;
      background-color:#1c1a17;
      opacity:0;visibility:hidden;transform:translateY(-6px);
      transition:opacity .2s ease, transform .2s ease, visibility .2s;
      max-height:80vh;overflow-y:auto;
      box-shadow:0 12px 24px rgba(0,0,0,0.4);
    }
    .mobile-nav.open{opacity:1;visibility:visible;transform:translateY(0);}
    .mobile-nav-inner{display:flex;flex-direction:column;background-color:#1c1a17;}
    .mobile-nav a{padding:12px 28px;font-size:0.72rem;letter-spacing:0.08em;text-transform:uppercase;color:var(--cream-dim);border-top:1px solid var(--line);background-color:#1c1a17;}
    .mobile-nav a:hover{color:var(--gold);}
    .page-hero-content{padding-top:84px;}
    .markets{grid-template-columns:1fr;}
    .split{grid-template-columns:1fr;min-height:0;}
    .split-text{padding:56px 28px;}
    .split-img{height:340px;}
    .impressions-grid{grid-template-columns:1fr 1fr;}
    .impressions-grid a{height:180px;}
    .trucks-grid{grid-template-columns:1fr;}
    .footer-grid{grid-template-columns:1fr 1fr;}
    section{padding:80px 0;}
  }
</style>
</head>
