<script>
  const navToggle = document.getElementById('navToggle');
  const mobileNav = document.getElementById('mobileNav');
  navToggle.addEventListener('click', () => {
    const isOpen = mobileNav.classList.toggle('open');
    navToggle.setAttribute('aria-expanded', isOpen);
    navToggle.textContent = isOpen ? '✕' : '☰';
  });

  const form = document.getElementById('kochkurs-form');
  const formSuccess = document.getElementById('formSuccess');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const subject = encodeURIComponent('Kochkurs-Anfrage: ' + d.get('name'));
    const body = encodeURIComponent(
      `Name: ${d.get('name')}\nE-Mail: ${d.get('email')}\nTelefon: ${d.get('telefon')}\nWunschdatum: ${d.get('datum')}\nGruppengröße: ${d.get('gruppe')}\nAnlass: ${d.get('anlass')}\n\nNachricht:\n${d.get('nachricht')}`
    );
    window.location.href = `mailto:info@redlotus-asianfood.com?subject=${subject}&body=${body}`;
    formSuccess.classList.add('show');
  });
</script>
