<style>
  :root{
    --bg:#1c1a17;
    --bg-2:#232019;
    --red:#c8382b;
    --red-bright:#e0473a;
    --gold:#d3b78c;
    --gold-soft:#bfa274;
    --cream:#f5f0e6;
    --cream-dim:#cdc6b8;
    --line:rgba(211,183,140,0.22);
    --serif:'Cormorant Garamond', Georgia, serif;
    --sans:'Bricolage Grotesque', sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg);
    color:var(--cream);
    font-family:var(--sans);
    font-weight:400;
    line-height:1.6;
    overflow-x:hidden;
  }
  img{max-width:100%;display:block;}
  a{color:inherit;text-decoration:none;}
  a:focus-visible,button:focus-visible,summary:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--gold);outline-offset:3px;border-radius:2px;}
  .eyebrow{
    font-family:var(--sans);
    font-size:0.72rem;
    letter-spacing:0.32em;
    text-transform:uppercase;
    color:var(--gold);
    font-weight:600;
  }
  h1,h2,h3{font-family:var(--serif);font-weight:500;color:var(--cream);}
  .wrap{max-width:1180px;margin:0 auto;padding:0 32px;}
  .wrap-wide{max-width:1440px;}
  .btn{
    display:inline-flex;align-items:center;gap:10px;
    padding:16px 30px;
    font-family:var(--sans);font-size:0.78rem;letter-spacing:0.14em;text-transform:uppercase;font-weight:600;
    border-radius:2px;
    transition:all .25s ease;
    border:1px solid transparent;
    white-space:nowrap;
    cursor:pointer;
  }
  .btn-primary{background:var(--red);color:var(--cream);}
  .btn-primary:hover{background:var(--red-bright);transform:translateY(-1px);}
  .btn-outline{border-color:var(--gold-soft);color:var(--cream);}
  .btn-outline:hover{border-color:var(--gold);background:rgba(211,183,140,0.08);}
  .btn-ghost{color:var(--gold);font-size:0.74rem;letter-spacing:0.12em;text-transform:uppercase;font-weight:600;border-bottom:1px solid var(--line);padding-bottom:2px;}
  .btn-ghost:hover{border-color:var(--gold);}

  /* Header */
  header{
    position:fixed;top:0;left:0;right:0;z-index:100;
    background:linear-gradient(to bottom, rgba(23,20,17,0.92), rgba(23,20,17,0));
    padding:22px 0;
  }
  header .wrap{display:flex;align-items:center;justify-content:space-between;gap:24px;}
  .logo img{height:58px;width:auto;filter:drop-shadow(0 2px 10px rgba(0,0,0,0.5));}
  .nav-toggle{display:none;background:none;border:1px solid var(--line);width:44px;height:44px;border-radius:50%;color:var(--cream);font-size:1.1rem;align-items:center;justify-content:center;}
  nav{display:flex;align-items:center;gap:34px;}
  nav a{font-size:0.72rem;letter-spacing:0.14em;text-transform:uppercase;font-weight:600;color:var(--cream-dim);position:relative;padding:6px 0;}
  nav a:hover{color:var(--gold);}
  .nav-dropdown{position:relative;}
  .nav-dropdown:hover .dropdown-menu,.nav-dropdown:focus-within .dropdown-menu{opacity:1;visibility:visible;transform:translateY(0);}
  .dropdown-menu{
    position:absolute;top:100%;left:50%;transform:translate(-50%,6px);
    background:var(--bg-2);border:1px solid var(--line);
    min-width:230px;padding:10px 0;margin-top:8px;
    opacity:0;visibility:hidden;transition:all .2s ease;
  }
  .dropdown-menu a{display:block;padding:12px 22px;font-size:0.7rem;letter-spacing:0.08em;color:var(--cream-dim);}
  .dropdown-menu a:hover{color:var(--gold);background:rgba(211,183,140,0.06);}
  .header-icons{display:flex;gap:16px;align-items:center;}
  .header-icons a{width:34px;height:34px;border:1px solid var(--line);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:0.9rem;}
  .header-icons a:hover{border-color:var(--gold);}

  /* Hero */
  .hero{
    position:relative;min-height:100vh;display:flex;align-items:center;
    background:
      linear-gradient(180deg, rgba(20,17,14,0.6) 0%, rgba(20,17,14,0.75) 55%, rgba(20,17,14,0.96) 100%),
      url('img/hero-buffet.jpg') center 38%/cover no-repeat;
  }
  .hero-content{max-width:660px;padding-top:120px;}
  .hero .eyebrow{margin-bottom:22px;display:block;}
  .hero h1{font-size:clamp(2.6rem,5.4vw,4.4rem);line-height:1.08;margin-bottom:24px;}
  .hero h1 em{font-style:italic;color:var(--red-bright);}
  .hero p.lead{font-size:1.08rem;color:var(--cream-dim);max-width:480px;margin-bottom:38px;font-weight:400;}
  .hero-ctas{display:flex;flex-wrap:wrap;gap:16px;margin-bottom:26px;}
  .hero-tertiary{font-size:0.75rem;color:var(--cream-dim);}
  .hero-tertiary a{color:var(--gold);border-bottom:1px solid var(--line);}

  /* Market strip */
  .market-strip{
    background:var(--bg-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line);
    padding:20px 0;
  }
  .market-strip .wrap{display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap;text-align:center;}
  .market-strip .label{color:var(--gold);font-size:0.68rem;letter-spacing:0.2em;text-transform:uppercase;font-weight:700;}
  .market-strip .days{display:flex;gap:28px;flex-wrap:wrap;font-size:0.85rem;color:var(--cream-dim);}
  .market-strip .days b{color:var(--cream);font-weight:600;}

  /* Section generic */
  section{padding:120px 0;}
  .section-head{max-width:640px;margin:0 auto 64px;text-align:center;}
  .section-head .eyebrow{display:block;margin-bottom:16px;}
  .section-head h2{font-size:clamp(2rem,3.6vw,2.8rem);}
  .section-head p{color:var(--cream-dim);margin-top:18px;font-size:1rem;}

  /* Value props */
  .values{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);}
  .value-card{background:var(--bg);padding:44px 32px;text-align:center;}
  .value-card .num{font-family:var(--serif);font-size:2.2rem;color:var(--red);margin-bottom:16px;}
  .value-card h3{font-size:1.15rem;margin-bottom:12px;}
  .value-card p{font-size:0.88rem;color:var(--cream-dim);}

  /* Event proof */
  .proof{padding:0;}
  .proof-grid{display:grid;grid-template-columns:0.9fr 1.3fr;min-height:620px;}
  .proof-img{position:relative;overflow:hidden;}
  .proof-img img{width:100%;height:100%;object-fit:cover;display:block;}
  .proof-text{background:var(--bg-2);display:flex;align-items:center;padding:70px 64px;}
  .proof-text .eyebrow{display:block;margin-bottom:18px;}
  .proof-text h2{font-size:clamp(1.8rem,2.6vw,2.4rem);margin-bottom:20px;}
  .proof-text p{color:var(--cream-dim);margin-bottom:12px;}
  .proof-cities{margin-top:24px;font-size:0.8rem;color:var(--gold-soft);letter-spacing:0.04em;line-height:1.9;}

  /* Reviews */
  .reviews{background:var(--bg-2);}
  .reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);}
  .review-card{background:var(--bg);padding:44px 38px;display:flex;flex-direction:column;}
  .review-stars{color:var(--gold);font-size:0.95rem;letter-spacing:0.14em;margin-bottom:20px;}
  .review-card blockquote{font-family:var(--serif);font-style:italic;font-size:1.15rem;line-height:1.5;color:var(--cream);margin-bottom:24px;flex-grow:1;}
  .review-meta{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line);padding-top:18px;}
  .review-name{font-size:0.85rem;font-weight:600;color:var(--cream);}
  .review-source{display:flex;align-items:center;gap:6px;font-size:0.7rem;color:var(--cream-dim);}
  .review-source .g-badge{width:16px;height:16px;border-radius:50%;background:transparent;border:1px solid var(--gold-soft);color:var(--gold);font-family:var(--sans);font-weight:700;font-size:0.6rem;display:flex;align-items:center;justify-content:center;}
  .reviews-cta{text-align:center;margin-top:44px;}

  /* Gallery */
  .gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(2,320px);gap:20px;}
  .gallery-grid a{position:relative;overflow:hidden;}
  .gallery-grid img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease;}
  .gallery-grid a:hover img{transform:scale(1.06);}
  .gallery-grid a::after{content:'';position:absolute;inset:0;box-shadow:inset 0 0 0 1px var(--line);}

  /* Catering paths */
  .paths{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);}
  .path-card{background:var(--bg-2);padding:54px 40px;position:relative;transition:background .25s ease;}
  .path-card:hover{background:#26221c;}
  .path-card .eyebrow{display:block;margin-bottom:14px;}
  .path-card h3{font-size:1.5rem;margin-bottom:16px;}
  .path-card p{color:var(--cream-dim);font-size:0.9rem;margin-bottom:28px;min-height:66px;}

  /* Kochkurs teaser */
  .kochkurs{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;}
  .kochkurs img{width:100%;height:460px;object-fit:cover;}
  .kochkurs .eyebrow{display:block;margin-bottom:18px;}
  .kochkurs h2{font-size:clamp(1.9rem,3vw,2.5rem);margin-bottom:22px;}
  .kochkurs p{color:var(--cream-dim);margin-bottom:16px;}
  .kochkurs ul{margin:24px 0 32px;padding:0;list-style:none;}
  .kochkurs li{padding-left:26px;position:relative;color:var(--cream-dim);font-size:0.92rem;margin-bottom:10px;}
  .kochkurs li::before{content:'❊';position:absolute;left:0;color:var(--red);}

  /* Footer */
  footer{background:var(--bg-2);border-top:1px solid var(--line);padding:80px 0 40px;}
  .footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:50px;margin-bottom:60px;}
  .footer-logo img{height:70px;margin-bottom:20px;}
  .footer-grid p{color:var(--cream-dim);font-size:0.88rem;max-width:280px;}
  .footer-col h3{font-size:0.7rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--gold);margin-bottom:20px;}
  .footer-col a{display:block;font-size:0.85rem;color:var(--cream-dim);margin-bottom:12px;}
  .footer-col a:hover{color:var(--gold);}
  .footer-social{display:flex;gap:14px;margin-top:20px;}
  .footer-social a{width:38px;height:38px;border:1px solid var(--line);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--gold);}
  .footer-insta-teaser{font-size:0.8rem;color:var(--cream-dim);margin-top:16px;}
  .footer-insta-teaser a{color:var(--gold);border-bottom:1px solid var(--line);}
  .footer-bottom{border-top:1px solid var(--line);padding-top:28px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px;font-size:0.75rem;color:var(--cream-dim);}
  .footer-bottom a{margin-left:18px;}

  .mobile-nav{display:none;}
  @media(max-width:960px){
    nav{display:none;}
    .nav-toggle{display:flex;width:38px;height:38px;font-size:0.95rem;}
    header{background-color:#1c1a17;background-image:none;padding:14px 0;}
    .logo img{height:32px;}
    .header-icons{gap:10px;}
    .header-icons a{width:30px;height:30px;font-size:0.8rem;}
    .mobile-nav{
      display:block;
      position:absolute;top:100%;left:0;right:0;
      background-color:#1c1a17;
      opacity:0;visibility:hidden;transform:translateY(-6px);
      transition:opacity .2s ease, transform .2s ease, visibility .2s;
      max-height:80vh;overflow-y:auto;
      box-shadow:0 12px 24px rgba(0,0,0,0.4);
    }
    .mobile-nav.open{opacity:1;visibility:visible;transform:translateY(0);}
    .mobile-nav-inner{display:flex;flex-direction:column;background-color:#1c1a17;}
    .mobile-nav a{padding:12px 28px;font-size:0.72rem;letter-spacing:0.08em;text-transform:uppercase;color:var(--cream-dim);border-top:1px solid var(--line);background-color:#1c1a17;}
    .mobile-nav a:hover{color:var(--gold);}
    .hero-content{padding-top:84px;}
    .values{grid-template-columns:1fr;}
    .value-card{padding:36px 32px;}
    .paths{grid-template-columns:1fr;}
    .reviews-grid{grid-template-columns:1fr;}
    .review-card{padding:36px 28px;}
    .gallery-grid{grid-template-columns:1fr 1fr;grid-template-rows:repeat(3,180px);gap:12px;}
    .proof-grid{grid-template-columns:1fr;min-height:0;}
    .proof-text{padding:56px 28px;}
    .proof-img{height:340px;}
    .kochkurs{grid-template-columns:1fr;gap:36px;}
    .kochkurs img{height:320px;}
    .footer-grid{grid-template-columns:1fr 1fr;}
    section{padding:80px 0;}
  }
</style>
</head>
