# Red Lotus Asian Food — Serverkonfiguration
# Hostinger (LiteSpeed, Apache-kompatibel)
#
# Zweck dieser Datei:
#   1. Weiterleitungen der alten Wix-URLs auf die neuen .html-Adressen
#   2. Vereinheitlichung auf die Variante ohne www
#   3. Kompression und Browser-Caching
#   4. Sperren interner Dateien und Sicherheits-Header (25.08.2026,
#      nach dem Sicherheits- und Rechtscheck)
#
# Angelegt 19.08.2026 nach dem SEO-Audit. Hintergrund: Beim Umzug von Wix
# auf die statische Seite (17./18.08.2026) wurden die alten URLs nicht
# weitergeleitet. Sie stehen aber noch im Google-Index und liefern seither
# eine Fehlerseite. Die Weiterleitungen übertragen die Ranking-Signale der
# alten Adressen auf die neuen.

# ---------------------------------------------------------------------------
# 0. Gesperrte Pfade (Sicherheits-/Rechtscheck 25.08.2026)
# ---------------------------------------------------------------------------
# 0a. Alte Seitenversionen (.fuse_hidden…): Mount-Artefakte, die vor der
#     .gitignore-Erweiterung mit eingecheckt und deployt wurden. Bis das
#     Repo aufgeräumt ist, liefert der Server für diese Pfade 404 —
#     darunter war eine veraltete Datenschutzerklärung abrufbar.
RedirectMatch 404 ^/\.fuse_hidden

# 0b. Interne Arbeitsdateien (Design-/Produktnotizen, Werkzeuge, Audits):
#     werden für die Arbeit am Projekt gebraucht und bleiben im Repo,
#     gehören aber nicht öffentlich ins Netz.
#     llms.txt, robots.txt und sitemap.xml bleiben bewusst öffentlich.
RedirectMatch 404 ^/(DESIGN|DESIGN-PLAN|PRODUCT|LIVE-SCHALTUNG_DNS|HOSTINGER-ANFRAGE_GPTBot)\.md$
RedirectMatch 404 ^/(tools|referenzen|\.impeccable|\.github)/

RewriteEngine On

# ---------------------------------------------------------------------------
# 1. www entfernen
# ---------------------------------------------------------------------------
# Alle canonical-Angaben und die sitemap.xml zeigen auf die Variante ohne www.
# Bisher lieferten beide Varianten die Seite gleichwertig aus.
# %1 ist die Domain ohne "www.", übernommen aus der RewriteCond.

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ---------------------------------------------------------------------------
# 1b. /index.html aus der Adresszeile fernhalten (22.08.2026)
# ---------------------------------------------------------------------------
# Die Startseite ist unter / und /index.html identisch erreichbar; canonical
# und sitemap zeigen auf /. Wer index.html direkt aufruft (alte Lesezeichen,
# frühere interne Links), landet per 301 auf der sauberen Adresse.
# THE_REQUEST greift nur bei der tatsächlich angefragten URL — nicht beim
# internen Auflösen von / auf index.html, sonst entstünde eine Schleife.

RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# ---------------------------------------------------------------------------
# 2. Weiterleitungen der alten Wix-Adressen
# ---------------------------------------------------------------------------
# Die alte Seite nutzte URLs ohne Dateiendung. Jede Regel akzeptiert die
# Adresse mit und ohne abschließenden Schrägstrich.
#
# Stand 19.08.2026: Alle Ziele sind vollwertige Seiten. Die anfänglichen
# Näherungen (/catering auf den Startseiten-Abschnitt, /kontakt auf die FAQ)
# sind entfallen, seit catering.html und kontakt.html existieren.

RewriteRule ^catering/?$              /catering.html          [R=301,L]
RewriteRule ^foodtruck/?$             /foodtruck.html         [R=301,L]
RewriteRule ^galerie/?$               /galerie.html           [R=301,L]
RewriteRule ^faq/?$                   /faq.html               [R=301,L]
RewriteRule ^impressum/?$             /impressum.html         [R=301,L]
RewriteRule ^kontakt/?$               /kontakt.html           [R=301,L]
RewriteRule ^contact-5/?$             /kontakt.html           [R=301,L]

# Umlaut-Adressen der alten Seite. Je nach Serverkonfiguration erreicht den
# RewriteRule-Vergleich die dekodierte oder die prozentkodierte Form,
# deshalb sind beide Schreibweisen hinterlegt.
RewriteRule ^über-uns/?$              /ueber-uns.html         [R=301,L]
RewriteRule ^%C3%BCber-uns/?$         /ueber-uns.html         [R=301,L]
RewriteRule ^ueber-uns/?$             /ueber-uns.html         [R=301,L]

RewriteRule ^datenschutzerklärung/?$      /datenschutz.html   [R=301,L]
RewriteRule ^datenschutzerkl%C3%A4rung/?$ /datenschutz.html   [R=301,L]
RewriteRule ^datenschutzerklaerung/?$     /datenschutz.html   [R=301,L]

# Wix-Startseitenvariante
RewriteRule ^home/?$                  /                       [R=301,L]

# ---------------------------------------------------------------------------
# 3. Kompression
# ---------------------------------------------------------------------------

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# 4. Browser-Caching
# ---------------------------------------------------------------------------
# Bilder und Schriften ändern sich selten und bekommen eine lange Frist.
# HTML bleibt kurz, damit Änderungen an der Seite sofort ankommen.

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg          "access plus 1 year"
  ExpiresByType image/png           "access plus 1 year"
  ExpiresByType image/webp          "access plus 1 year"
  ExpiresByType image/avif          "access plus 1 year"
  ExpiresByType image/svg+xml       "access plus 1 year"
  ExpiresByType font/woff2          "access plus 1 year"
  ExpiresByType text/css            "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  # HTML immer frisch ausliefern (25.08.2026, vorher 1 Stunde): Korrekturen
  # an Rechtstexten sollen Besucher sofort erreichen, wie bei Site 2.
  ExpiresByType text/html           "access plus 0 seconds"
</IfModule>

# ---------------------------------------------------------------------------
# 5. Zeichenkodierung
# ---------------------------------------------------------------------------

AddDefaultCharset UTF-8

# pricing.md ist die maschinenlesbare Preisliste für KI-Systeme und -Agenten
# (GEO-Check 05.09.2026). Ohne diese Zeile liefert der Server .md je nach
# Konfiguration als Download aus, statt es als Text darzustellen. Die Sperrliste
# in Abschnitt 1 betrifft ausschließlich die internen Arbeitsdateien —
# pricing.md steht dort bewusst nicht drin und bleibt öffentlich.
<Files "pricing.md">
  ForceType text/plain
  Header set Content-Type "text/plain; charset=UTF-8"
</Files>

# ---------------------------------------------------------------------------
# 6. Sicherheits-Header (Sicherheits-/Rechtscheck 25.08.2026)
# ---------------------------------------------------------------------------
# Die Content-Security-Policy ist auf den tatsächlichen Bestand der Seite
# zugeschnitten und muss bei neuen externen Einbindungen mitwachsen:
#   - script-src/style-src 'unsafe-inline': alle Seiten arbeiten mit
#     Inline-<style>- und Inline-<script>-Blöcken (kein externes JS/CSS).
#   - img-src data:: Event-Poster aus Firestore kommen als data:-URIs.
#   - connect-src firestore.googleapis.com: Speiseplan/News per REST.
#   - connect-src wixformwebhook-…run.app: Ziel der Anfrage-Formulare.
# Schriften liegen lokal (font-src 'self'), es gibt keine iframes und
# keine weiteren externen Quellen.

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://firestore.googleapis.com https://wixformwebhook-e6seurotja-ew.a.run.app; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
